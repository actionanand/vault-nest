<resources>
    <style name="Theme.VaultNestWear" parent="android:style/Theme.DeviceDefault">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/wear_background</item>
        <item name="android:navigationBarColor">@color/wear_background</item>
        <item name="android:statusBarColor">@color/wear_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.VaultNestWear.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vault_nest_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.VaultNestWear</item>
    </style>
</resources>
