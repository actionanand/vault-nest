<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/vault_nest_launcher"
        android:roundIcon="@mipmap/vault_nest_launcher_round"
        android:label="@string/wear_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VaultNestWear">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".WatchVaultListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/vaultnest/watch" />
            </intent-filter>
        </service>
    </application>
</manifest>
